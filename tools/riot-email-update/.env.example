# Optional — leave blank to be prompted interactively.
# Never commit a real .env file.

RIOT_USERNAME=
RIOT_PASSWORD=
NEW_EMAIL=

# Capless (https://capless.lol/) — supports Riot sitekey (tokens often soft-fail verify)
CAPTCHA_PROVIDER=capless
CAPLESS_API_KEY=
# http://user:pass@host:port  OR host:port:user:pass
CAPLESS_PROXY=
BROWSER_PROXY=
PROXY_LIST=data/proxies.txt

# Alternate enterprise solvers (set key + CAPTCHA_PROVIDER=…):
#   capmonster  — CapMonster Cloud (customData=rqdata) — common in Riot auth scripts
#   twocaptcha  — 2Captcha (data=rqdata + matching User-Agent)
#   nonecap     — NoneCap hcaptcha_enterprise
#   capsolver   — CapSolver (currently rejects Riot sitekey)
CAPMONSTER_API_KEY=
TWOCAPTCHA_API_KEY=
NONECAP_API_KEY=
# Optional override for CapMonster/2Captcha websiteURL (default auth.riotgames.com)
# HCAPTCHA_WEBSITE_URL=https://auth.riotgames.com

# Legacy CapSolver:
CAPSOLVER_API_KEY=

# IMAP for the CURRENT Riot account email (login MFA + ownership codes)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SSL=true

# IMAP for the NEW email (confirmation code / verify link)
NEW_IMAP_HOST=
NEW_IMAP_PORT=993
NEW_IMAP_USER=
NEW_IMAP_PASSWORD=
NEW_IMAP_FOLDER=INBOX
NEW_IMAP_SSL=true

HEADED=true
