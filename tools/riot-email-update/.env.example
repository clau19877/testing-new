# Optional — leave blank to be prompted interactively.
# Never commit a real .env file.

RIOT_USERNAME=
RIOT_PASSWORD=
NEW_EMAIL=

# Login ENTRY opened first. Default = docs.qq.com interstitial that Continues
# into https://account.riotgames.com/ (click-through). Override if needed:
# LOGIN_URL=
# LOGIN_ENTRY_URL=
# ACCOUNT_LOGIN_URL=
# Direct authenticate OAuth (usually worse than the click-through):
# LOGIN_URL=authenticate   # special: builds accountodactyl-prod email.edit URL

# Page opened AFTER login to edit the email field.
# Default: https://account.riotgames.com/
EMAIL_CHANGE_URL=https://account.riotgames.com/

# Capless (https://capless.lol/) — tokens often soft-fail verify on Riot
# CAPTCHA_PROVIDER=capless
CAPLESS_API_KEY=
# http://user:pass@host:port  OR host:port:user:pass
CAPLESS_PROXY=
BROWSER_PROXY=
PROXY_LIST=data/proxies.txt
PROXY_INDEX=0
PROXY_ATTEMPTS=3

# Alternate enterprise solvers (set key + CAPTCHA_PROVIDER=…):
#   capmonster  — CapMonster Cloud — hCaptcha REMOVED ~2026-03
#   twocaptcha  — 2Captcha token API — mints tokens, Riot often soft-fails
#   nonecap     — NoneCap — same soft-fail pattern
#   capsolver   — CapSolver (rejects Riot sitekey)
# Strict enterprise bind (token path): require rqdata + proxy + matched UA
ENTERPRISE_STRICT=1
# RIOT_UA_MODE=chrome   # chrome | riot  (API login / probe_enterprise_strict.py)
# HCAPTCHA_WEBSITE_URL=https://authenticate.riotgames.com/
CAPMONSTER_API_KEY=
TWOCAPTCHA_API_KEY=
YESCAPTCHA_API_KEY=
NONECAP_API_KEY=

# RECOMMENDED for Riot: solve hCaptcha by hand, automate everything else.
#   CAPTCHA_PROVIDER=manual  → auto-fills login + clicks sign-in, then PAUSES
#   for a human to solve the hCaptcha in the browser window; once it clears,
#   MFA (IMAP) and the email update continue automatically.
#   Forces headed + single session. Tune the wait with MANUAL_CAPTCHA_TIMEOUT.
# MANUAL_CAPTCHA_TIMEOUT=300
# Full-window browser so the hCaptcha tile table is not clipped:
# BROWSER_VIEWPORT=full          # full | 1920x1080 | 1280x900
# HCAPTCHA_VIEW_SCALE=1.25       # enlarge challenge popup (1.0–1.75)
# Local: just run headed and solve in the real browser.
# Windows one-click: double-click RiotEmailUpdate.exe (see WINDOWS.md).
# Remote VM: ./start_manual_session.sh  (Xvfb + x11vnc + noVNC on :6080)

# DEFAULT Riot path: in-browser hybrid captcha (NOT out-of-band tokens)
CAPTCHA_PROVIDER=vision
VISION_BACKEND=hybrid
#   hybrid/auto  — local CV → YesCaptcha Classification → 2Captcha Coordinates
#   yescaptcha  — YesCaptcha HCaptchaClassification only
#   twocaptcha   — always ask 2Captcha workers (VISION_LOCAL_FIRST=1 to also try local)
#   ocr          — local OpenCV only
VISION_LOCAL_FIRST=0
VISION_2CAP_FALLBACK=1
# Multibot-style stealth + human mouse (no Multibot API key required):
#   BROWSER_ENGINE=patchright | camoufox | playwright
BROWSER_ENGINE=patchright
HUMAN_MOUSE=1
# Optional further solvers:
# MULTIBOT_API_KEY=     # Canvas/Drag click + token (https://multibot.in)
# NOPECHA_API_KEY=      # Enterprise token with rqdata+proxy
# Capless already maps Riot sitekey 019f1553-… (UA sync on submit)
# Labeled samples → debug/training_samples/  (python local_solver.py eval)

# Legacy CapSolver:
CAPSOLVER_API_KEY=

# IMAP for the CURRENT Riot account email (login MFA + ownership codes)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SSL=true

# IMAP for the NEW email (confirmation code / verify link)
NEW_IMAP_HOST=
NEW_IMAP_PORT=993
NEW_IMAP_USER=
NEW_IMAP_PASSWORD=
NEW_IMAP_FOLDER=INBOX
NEW_IMAP_SSL=true

HEADED=true

# Session logs (everything printed + page navigations) land in:
#   debug/logs/session_YYYYMMDD_HHMMSS_<username>.log
# Keep these when reporting issues — they drive enhancements.
