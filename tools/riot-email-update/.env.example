# Optional — leave blank to be prompted interactively.
# Never commit a real .env file.

RIOT_USERNAME=
RIOT_PASSWORD=
NEW_EMAIL=

# Capless (https://capless.lol/) — supports Riot sitekey (tokens often soft-fail verify)
CAPTCHA_PROVIDER=capless
CAPLESS_API_KEY=
# http://user:pass@host:port  OR host:port:user:pass
CAPLESS_PROXY=
BROWSER_PROXY=
PROXY_LIST=data/proxies.txt

# Alternate enterprise solvers (set key + CAPTCHA_PROVIDER=…):
#   capmonster  — CapMonster Cloud (customData=rqdata) — hCaptcha REMOVED ~2026-03
#   twocaptcha  — 2Captcha token API (data=rqdata) — mints tokens, Riot often soft-fails
#   nonecap     — NoneCap hcaptcha_enterprise — same soft-fail pattern
#   capsolver   — CapSolver (rejects Riot sitekey)
CAPMONSTER_API_KEY=
TWOCAPTCHA_API_KEY=
NONECAP_API_KEY=

# Preferred Riot path: in-browser hybrid captcha (NOT out-of-band tokens)
#   VISION_BACKEND=hybrid|twocaptcha|ocr|auto
#     hybrid/auto  — local CV first, 2Captcha Coordinates as fallback/oracle
#     twocaptcha   — always ask 2Captcha workers (still local-first unless
#                    VISION_LOCAL_FIRST=0)
#   VISION_LOCAL_FIRST=1        try OpenCV letter/drag before 2cap
#   VISION_2CAP_FALLBACK=1      OCR empty → 2Captcha clicks
# Labeled samples → debug/training_samples/  (python local_solver.py eval)

# Legacy CapSolver:
CAPSOLVER_API_KEY=

# IMAP for the CURRENT Riot account email (login MFA + ownership codes)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SSL=true

# IMAP for the NEW email (confirmation code / verify link)
NEW_IMAP_HOST=
NEW_IMAP_PORT=993
NEW_IMAP_USER=
NEW_IMAP_PASSWORD=
NEW_IMAP_FOLDER=INBOX
NEW_IMAP_SSL=true

HEADED=true
