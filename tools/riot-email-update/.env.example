# Optional — leave blank to be prompted interactively.
# Never commit a real .env file.
#
# macOS Safari (usually no captcha locally): see MAC_SAFARI.md
#   ./run_safari_mac.sh

RIOT_USERNAME=
RIOT_PASSWORD=
NEW_EMAIL=

# Login ENTRY opened first. Default = docs.qq.com interstitial that Continues
# into https://account.riotgames.com/ (click-through). Override if needed:
# LOGIN_URL=
# LOGIN_ENTRY_URL=
# ACCOUNT_LOGIN_URL=
# Direct authenticate OAuth (usually worse than the click-through):
# LOGIN_URL=authenticate   # special: builds accountodactyl-prod email.edit URL

# Page opened AFTER login to edit the email field.
# Default: https://account.riotgames.com/
EMAIL_CHANGE_URL=https://account.riotgames.com/

# ---------------------------------------------------------------------------
# IN-BOT CAPTCHA (recommended — same approach as retail bots that disable
# hCaptcha→AYCD and solve inside the browser instead of token harvesters)
# ---------------------------------------------------------------------------
#
# Option A — human in the browser (fastest / most reliable for Riot):
#   CAPTCHA_PROVIDER=manual
#   HEADED=true
#   Tool fills login + clicks sign-in, then PAUSES for you to solve the grid.
#   MFA (IMAP) and email update continue automatically after it clears.
#
# Option B — in-bot OCR/AI clicks (unattended):
#   CAPTCHA_PROVIDER=vision
#   VISION_BACKEND=hybrid
#   TWOCAPTCHA_API_KEY=…   # Coordinates fallback when local CV misses
#   YESCAPTCHA_API_KEY=…   # optional classification
#
# MANUAL_CAPTCHA_TIMEOUT=300
# BROWSER_VIEWPORT=full          # full | 1920x1080 | 1280x900
# HCAPTCHA_VIEW_SCALE=1.25       # enlarge challenge popup (1.0–1.75)

# DEFAULT: in-bot hybrid vision (NOT out-of-band tokens / AYCD)
CAPTCHA_PROVIDER=vision
VISION_BACKEND=hybrid
#   hybrid/auto  — local CV → YesCaptcha Classification → 2Captcha Coordinates
#   yescaptcha   — YesCaptcha HCaptchaClassification only
#   twocaptcha   — always ask 2Captcha workers (VISION_LOCAL_FIRST=1 to also try local)
#   ocr          — local OpenCV only
VISION_LOCAL_FIRST=0
VISION_2CAP_FALLBACK=1
TWOCAPTCHA_API_KEY=
YESCAPTCHA_API_KEY=

# Browser / stealth
BROWSER_ENGINE=patchright
HUMAN_MOUSE=1
# BROWSER_ENGINE=patchright | camoufox | playwright

# Proxies (optional; same IP for browser helps token APIs if you use them)
# http://user:pass@host:port  OR host:port:user:pass
CAPLESS_PROXY=
BROWSER_PROXY=
PROXY_LIST=data/proxies.txt
PROXY_INDEX=0
PROXY_ATTEMPTS=3

# Legacy / alternate token APIs (often soft-fail on Riot enterprise):
#   CAPTCHA_PROVIDER=capless|twocaptcha|nonecap|capmonster|capsolver
# CapSolver hard-rejects Riot's sitekey; CapMonster removed hCaptcha ~2026-03.
ENTERPRISE_STRICT=1
# HCAPTCHA_WEBSITE_URL=https://authenticate.riotgames.com/
CAPLESS_API_KEY=
CAPMONSTER_API_KEY=
NONECAP_API_KEY=
CAPSOLVER_API_KEY=

# Optional further solvers:
# MULTIBOT_API_KEY=     # Canvas/Drag click + token (https://multibot.in)
# NOPECHA_API_KEY=      # Enterprise token with rqdata+proxy

# IMAP for the CURRENT Riot account email (login MFA + ownership codes)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SSL=true

# IMAP for the NEW email (confirmation code / verify link)
NEW_IMAP_HOST=
NEW_IMAP_PORT=993
NEW_IMAP_USER=
NEW_IMAP_PASSWORD=
NEW_IMAP_FOLDER=INBOX
NEW_IMAP_SSL=true

# Browser window: true = show Chromium; false = headless (no window).
# Manual captcha needs HEADED=true so you can see/solve the grid.
# Unattended: CAPTCHA_PROVIDER=vision + TWOCAPTCHA_API_KEY (+ optional YESCAPTCHA).
HEADED=true
# Or pass: RiotEmailUpdate.exe --headless

# Session logs (everything printed + page navigations) land in:
#   debug/logs/session_YYYYMMDD_HHMMSS_<username>.log
# Keep these when reporting issues — they drive enhancements.
