# Optional — leave blank to be prompted interactively (recommended).
# Never commit a real .env file.

RIOT_USERNAME=
RIOT_PASSWORD=
NEW_EMAIL=

# CapSolver — recommended for Riot enterprise hCaptcha
# Sign up: https://www.capsolver.com/  → Dashboard → API Key
CAPSOLVER_API_KEY=

# Optional: residential proxy if CapSolver tokens are rejected (IP mismatch).
# Formats CapSolver accepts, e.g.:
#   http:1.2.3.4:8080:user:pass
#   OR leave blank to use CapSolver's proxyless pool
CAPSOLVER_PROXY=

# true = show browser (recommended; MFA still needs the window)
# false = headless (often fails on Riot login)
HEADED=true
