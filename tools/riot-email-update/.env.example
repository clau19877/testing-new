# Optional — leave blank to be prompted interactively.
# Never commit a real .env file.

RIOT_USERNAME=
RIOT_PASSWORD=
NEW_EMAIL=

# Captcha — CapSolver does NOT support Riot hCaptcha.
# Use Capless instead: https://capless.lol/
CAPTCHA_PROVIDER=capless
CAPLESS_API_KEY=
# Required for Capless (residential recommended):
#   http://user:pass@host:port
CAPLESS_PROXY=

# Legacy CapSolver (won't work on Riot sitekey):
CAPSOLVER_API_KEY=

# IMAP for the CURRENT Riot account email (login MFA + ownership codes)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SSL=true

# IMAP for the NEW email (confirmation code / verify link)
NEW_IMAP_HOST=
NEW_IMAP_PORT=993
NEW_IMAP_USER=
NEW_IMAP_PASSWORD=
NEW_IMAP_FOLDER=INBOX
NEW_IMAP_SSL=true

HEADED=true
