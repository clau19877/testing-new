# P-Bandai HK base
AREA_CODE=hk
BASE_URL=https://p-bandai.com
ACCEPT_LANGUAGE=en

# Direct product links/codes (preferred when you already know the URL)
# Comma-separated. Accepts full URLs or bare product codes.
# Example:
# PRODUCT_LINKS=https://p-bandai.com/hk/item/A2742450001,https://p-bandai.com/hk/item/A2690472004
PRODUCT_LINKS=
PRODUCT_CODES=

# Optional keyword search (leave empty if you only use PRODUCT_LINKS)
SEARCH_KEYWORDS=

# Match keywords against product names (en / zh-HK). Required only when SEARCH_KEYWORDS is set.
# PRECHECK_LIST: coarse filter (like JP bot abbreviated names)
# TARGET_LIST: finer match; leave empty to treat PRECHECK_LIST as final targets
PRECHECK_LIST=
TARGET_LIST=

# Only consider these sale statuses (comma-separated). Typical: On,Waiting
SALE_STATUSES=On,Waiting

# 0 = monitor + notify only (default)
# 1 = also attempt add-to-cart after manual browser login
ENABLE_ADD_TO_CART=0
CART_QTY=1
ADD_CART_RETRY_COUNT=5

# Browser login (only used when ENABLE_ADD_TO_CART=1)
BACKGROUND_MODE=0
LOGIN_URL=https://p-bandai.com/hk/login

# Run modes
# 0 = immediate loop, 1 = schedule at EXECUTE_TIME
SCHEDULE_MODE=0
EXECUTE_TIME=10:59,11:59,12:59,13:59,16:59,17:59
EXECUTE_SCHEDULE_POLLING_PERIOD=60
RETRY_WAIT=60

# How many search result pages to scan per keyword (limit * pages)
SEARCH_LIMIT=40
SEARCH_MAX_PAGES=3

# Logging (errors include traceback in the log file)
LOG_FILE=logs/pbandai_hk.log
LOG_LEVEL=INFO

# Email notify (optional; leave EMAIL_USER empty to skip)
EMAIL_USER=
EMAIL_PASSWORD=
RECEIVER_EMAIL=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
