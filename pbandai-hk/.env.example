# P-Bandai store base
AREA_CODE=us
BASE_URL=https://p-bandai.com
ACCEPT_LANGUAGE=en

# Direct product links/codes (required for click farm)
PRODUCT_LINKS=https://p-bandai.com/us/item/N2890904001
PRODUCT_CODES=N2890904001

# Optional keyword search (leave empty for click farm)
SEARCH_KEYWORDS=
PRECHECK_LIST=
TARGET_LIST=

SALE_STATUSES=On,Waiting

# Cart / click farm (no login)
ENABLE_ADD_TO_CART=1
# 1 = guest browsers click PLACE PRE-ORDER (default). No login / task.csv needed.
CLICK_FARM=1
BROWSER_INSTANCES=20
# ATC at wall-clock second :00 of every minute (0..59). Set -1 to use CLICK_INTERVAL_SECONDS.
CLICK_AT_SECOND=0
CLICK_INTERVAL_SECONDS=5
# Keep all instances running after cart success (Discord still notified each time)
STOP_ON_FIRST_CART=0
# Stagger Chrome launch + PDP (seconds * instance index + jitter) to cut PAGE NOT AVAILABLE
OPEN_STAGGER_SECONDS=1.5
# Retries when first PDP visit is 500 / page not available (backoff grows per attempt)
OPEN_PDP_RETRIES=5
OPEN_PDP_RETRY_WAIT=3
# Soft OUT OF STOCK: hard-refresh PDP while waiting for :00 (0=disable)
OOS_REFRESH_SECONDS=12
# Human-like idle while waiting (scroll / blank click). 0=disable
IDLE_ACTIVITY_SECONDS=8
# Discord incoming webhook — payment/cart link is posted on success
DISCORD_WEBHOOK_URL=

CART_QTY=1
ADD_CART_RETRY_COUNT=8

# Browser (headed recommended; headless often hits WAF)
BACKGROUND_MODE=0
BROWSER=auto

# Optional shared proxy (or put many rows in proxy.csv — round-robin across instances)
PROXY_URL=
PROXY_CSV=proxy.csv

# Legacy logged-in mode (only when CLICK_FARM=0)
LOGIN_URL=https://p-bandai.com/us/login
COOKIE_FILE=
SESSIONS_FILE=sessions.json
CART_MODE=all
CART_METHOD=warm
PREWARM_BROWSERS=0
REQUIRE_CART_INCREASE=1
DROP_LEAD_SECONDS=30
CART_PARALLEL=1
TASK_CSV=task.csv
PROXY_ASSIGN_MODE=random
TASK_PARALLEL_WORKERS=0

SCHEDULE_MODE=0
EXECUTE_TIME=10:59,11:59,12:59,13:59,16:59,17:59
EXECUTE_SCHEDULE_POLLING_PERIOD=60
RETRY_WAIT=60

SEARCH_LIMIT=40
SEARCH_MAX_PAGES=3

LOG_FILE=logs/pbandai_hk.log
LOG_LEVEL=INFO

# Email notify (optional; leave empty to skip)
EMAIL_USER=
EMAIL_PASSWORD=
RECEIVER_EMAIL=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
