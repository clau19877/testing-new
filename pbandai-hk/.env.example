# P-Bandai store base. AREA_CODE must match the product's region or the sale
# timing lookup 404s and the bot falls back to blind clicking.
AREA_CODE=hk
BASE_URL=https://p-bandai.com
ACCEPT_LANGUAGE=en

# Direct product links/codes (required for click farm)
PRODUCT_LINKS=https://p-bandai.com/hk/item/A2866726001
PRODUCT_CODES=A2866726001

# Optional keyword search (leave empty for click farm)
SEARCH_KEYWORDS=
PRECHECK_LIST=
TARGET_LIST=

SALE_STATUSES=On,Waiting

# Cart / click farm (no login)
ENABLE_ADD_TO_CART=1
# 1 = guest browsers click PLACE PRE-ORDER (default). No login / task.csv needed.
CLICK_FARM=1
BROWSER_INSTANCES=20
# ATC at wall-clock second :00 of every minute (0..59). Set -1 to use CLICK_INTERVAL_SECONDS.
CLICK_AT_SECOND=0
CLICK_INTERVAL_SECONDS=5
# Keep all instances running after cart success (Discord still notified each time)
STOP_ON_FIRST_CART=0
# Stagger Chrome launch + PDP (seconds * instance index + jitter) to cut PAGE NOT AVAILABLE
OPEN_STAGGER_SECONDS=1.5
# Retries when first PDP visit is 500 / page not available (backoff grows per attempt)
OPEN_PDP_RETRIES=5
OPEN_PDP_RETRY_WAIT=3
# Soft OUT OF STOCK / PNA: hard-refresh while waiting (jittered per instance; 0=disable)
OOS_REFRESH_SECONDS=18
# Max browsers navigating PDP/home at the same time (cuts heal stampede)
PDP_MAX_CONCURRENT=3
# Human-like idle while waiting (scroll / blank click). 0=disable
IDLE_ACTIVITY_SECONDS=8
# Per-instance Chrome profile + UA/viewport/locale (1=on)
UNIQUE_BROWSER_PROFILES=1
# Linger on /hk/ home (scroll) before first PDP open
HOME_WARMUP_SECONDS=3
# Hold clicks until orderStartDate for products not on sale yet, then burst-retry
PRERELEASE_WAIT=1
PREDROP_REFRESH_SECONDS=25
DROP_BURST_SECONDS=120
DROP_BURST_INTERVAL=2.5
# After ATC, park the winning instance's window on /{area}/cart for manual checkout
PARK_ON_CART=1
# Never close a Chrome window holding a cart (survives bot exit)
KEEP_BROWSER_OPEN=1
# Optional logged-in cookie exports (Cookie-Editor JSON), round-robined per instance.
# Start instances already signed in so you only press Proceed to checkout.
FARM_COOKIE_FILES=
# Discord incoming webhook — payment/cart link is posted on success
# REQUIRED for Discord alerts. Paste full URL, no quotes.
# Or put the same URL alone in discord_webhook.txt (survives .env reset).
DISCORD_WEBHOOK_URL=

CART_QTY=1
ADD_CART_RETRY_COUNT=8

# Browser (headed recommended; headless often hits WAF)
BACKGROUND_MODE=0
BROWSER=auto

# Optional shared proxy (or put many rows in proxy.csv — round-robin across instances)
PROXY_URL=
PROXY_CSV=proxy.csv

# Legacy logged-in mode (only when CLICK_FARM=0)
LOGIN_URL=https://p-bandai.com/hk/login
COOKIE_FILE=
SESSIONS_FILE=sessions.json
CART_MODE=all
CART_METHOD=warm
PREWARM_BROWSERS=0
REQUIRE_CART_INCREASE=1
DROP_LEAD_SECONDS=30
CART_PARALLEL=1
TASK_CSV=task.csv
PROXY_ASSIGN_MODE=random
TASK_PARALLEL_WORKERS=0

SCHEDULE_MODE=0
EXECUTE_TIME=10:59,11:59,12:59,13:59,16:59,17:59
EXECUTE_SCHEDULE_POLLING_PERIOD=60
RETRY_WAIT=60

SEARCH_LIMIT=40
SEARCH_MAX_PAGES=3

LOG_FILE=logs/pbandai_hk.log
LOG_LEVEL=INFO

# Email notify (optional; leave empty to skip)
EMAIL_USER=
EMAIL_PASSWORD=
RECEIVER_EMAIL=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
