# P-Bandai HK base
AREA_CODE=hk
BASE_URL=https://p-bandai.com
ACCEPT_LANGUAGE=en

# Direct product links/codes (preferred when you already know the URL)
# Comma-separated. Accepts full URLs or bare product codes.
# Example:
# PRODUCT_LINKS=https://p-bandai.com/hk/item/A2742450001,https://p-bandai.com/hk/item/A2690472004
PRODUCT_LINKS=
PRODUCT_CODES=

# Optional keyword search (leave empty if you only use PRODUCT_LINKS)
SEARCH_KEYWORDS=

# Match keywords against product names (en / zh-HK). Required only when SEARCH_KEYWORDS is set.
# PRECHECK_LIST: coarse filter (like JP bot abbreviated names)
# TARGET_LIST: finer match; leave empty to treat PRECHECK_LIST as final targets
PRECHECK_LIST=
TARGET_LIST=

# Only consider these sale statuses (comma-separated). Typical: On,Waiting
SALE_STATUSES=On,Waiting

# 0 = monitor + notify only (default)
# 1 = also attempt add-to-cart after manual browser login
ENABLE_ADD_TO_CART=0
CART_QTY=1
ADD_CART_RETRY_COUNT=5

# Browser login (only used when ENABLE_ADD_TO_CART=1)
BACKGROUND_MODE=0
LOGIN_URL=https://p-bandai.com/hk/login
# auto | chrome | edge
BROWSER=auto
# Optional: skip Selenium and load cookies from a Netscape/JSON cookie file
COOKIE_FILE=

# Proxy (single-session / fallback)
# Examples:
# PROXY_URL=http://127.0.0.1:8080
# PROXY_URL=http://user:pass@1.2.3.4:8080
# PROXY_URL=socks5://1.2.3.4:1080
PROXY_URL=

# Multi-session file (see sessions.example.json)
# Create sessions with:
#   python web_shopping_bot_hk.py login --name acc1 --proxy http://user:pass@host:8080
# Or fill task.csv + proxy.csv and run:
#   python web_shopping_bot_hk.py tasks
SESSIONS_FILE=sessions.json
# Cart fan-out across sessions: first | all | round_robin
CART_MODE=first
# How to add to cart:
#   auto    = warm (if PREWARM) -> API -> cold browser fallback
#   api     = API only
#   browser = cold browser each attempt (opens Chrome at T-0 — risky during drops)
#   warm    = pre-warmed browsers only (best for drops when HTML crashes)
# Site WAF often blocks bare POST /api/cart/addToCart with HTTP 501 HTML pages.
CART_METHOD=auto
# Park logged-in Chrome on the product page BEFORE the drop.
# At T-0 the bot fires in-page fetch (no reload) so HTML 502/503 won't kill the cart.
# Requires PRODUCT_LINKS/PRODUCT_CODES. Keep BACKGROUND_MODE=0 (headed).
PREWARM_BROWSERS=0

# CSV parallel tasks (N rows in task.csv => N sessions in parallel)
# Each task randomly selects one proxy from proxy.csv
# proxy.csv formats: host:port:user:pass  OR  http://user:pass@host:port
TASK_CSV=task.csv
PROXY_CSV=proxy.csv
# random = each task picks any proxy; unique = shuffle & assign without reuse when possible
PROXY_ASSIGN_MODE=random
# 0 = one browser/worker per task
TASK_PARALLEL_WORKERS=0
# Tip: set BACKGROUND_MODE=1 for headless parallel logins

# Run modes
# 0 = immediate loop, 1 = schedule at EXECUTE_TIME
SCHEDULE_MODE=0
EXECUTE_TIME=10:59,11:59,12:59,13:59,16:59,17:59
EXECUTE_SCHEDULE_POLLING_PERIOD=60
RETRY_WAIT=60

# How many search result pages to scan per keyword (limit * pages)
SEARCH_LIMIT=40
SEARCH_MAX_PAGES=3

# Logging (errors include traceback in the log file)
LOG_FILE=logs/pbandai_hk.log
LOG_LEVEL=INFO

# Email notify (optional; leave EMAIL_USER empty to skip)
EMAIL_USER=
EMAIL_PASSWORD=
RECEIVER_EMAIL=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
