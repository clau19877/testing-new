# Paths are relative to amazon-jp-account-system/ unless absolute.
CONFIG_PATH=config/default.json
IDENTITIES_PATH=config/identities.example.json
PROXIES_PATH=config/proxies.example.txt
ACCOUNTS_DB_PATH=data/accounts.json

# Browser profile manager (optional; dry-run does not need these)
# ADSPOWER_API_URL=http://local.adspower.net:50325
# GOLOGIN_TOKEN=
# GOLOGIN_API_URL=http://127.0.0.1:36912

# IMAP mailbox for Amazon OTP (required for --imap / mailbox.provider=imap)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=you@your-domain.example
IMAP_PASS=your-app-password-or-mailbox-password
IMAP_MAILBOX=INBOX
# Optional filters (comma-separated)
IMAP_FROM_INCLUDES=amazon
# IMAP_SUBJECT_INCLUDES=認証,OTP,verification
IMAP_LOOKBACK_MS=900000
IMAP_TLS_REJECT_UNAUTHORIZED=true
