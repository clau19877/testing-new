{
  "name": "amazon-jp-account-system",
  "version": "0.1.0",
  "private": true,
  "description": "Own-system orchestrator for parallel Amazon.co.jp account workflows using real identities you control",
  "type": "module",
  "bin": {
    "amz-jp": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "dry-run": "tsx src/cli.ts run --dry-run --count 3 --concurrency 2",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "p-limit": "^6.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
